# Dependencies — restored by `npm install` from package-lock.json.
# (package-lock.json itself SHOULD be committed, so it is not listed here.)
node_modules

# Build output — regenerated by `npm run build`. Hosts build this themselves.
dist
dist-ssr
*.local

# Environment files. Nothing here uses them today, but the rule is cheap
# insurance if you ever add one. Note: in Vite, any variable prefixed with
# VITE_ is baked into the public bundle — never put a real secret in one.
.env
.env.*
!.env.example

# macOS / Windows filesystem junk
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Deployment CLI state (created by `vercel` / `netlify` if you use them)
.vercel
.netlify

# Test coverage, if you add tests later
coverage

# Claude Code: launch.json is shared (it describes how to run the dev server).
# settings.local.json is a per-machine permission allowlist — keep it local.
.claude/settings.local.json
